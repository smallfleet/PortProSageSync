# Build artifacts
bin/
obj/
out/

# User-specific files
*.user
*.suo

# Rider / VS
.vs/
.idea/

# Logs, local state DB, and anything else the running service creates locally -
# runtime data, not source.
*.log
*.db
*.db-shm
*.db-wal
*.csv
/failed-transactions/

# Per-install real secrets (PortPro tokens, Sage50 password, and any other
# per-client values) - see Program.cs's AddJsonFile("appsettings.Local.json", ...).
# Every client deployment creates its own copy of this file locally; it must
# never be committed, since the same repo/build is shared across clients.
appsettings.Local.json
appsettings.*.Local.json

# OS cruft
.DS_Store
Thumbs.db

# Sage 50 SDK assemblies - third-party binaries that must match the Sage 50
# version installed on each machine that builds/runs this service; populate
# locally, don't commit (see PortProSage.Core.csproj for details).
lib/Sage50SDK/
