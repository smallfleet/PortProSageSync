# Build artifacts
bin/
obj/
out/

# User-specific files
*.user
*.suo

# Rider / VS
.vs/
.idea/

# Logs, local state DB, and anything else the running service creates locally on a
# given machine - these are runtime data, not source, and differ per environment.
*.log
*.db
*.db-shm
*.db-wal

# OS cruft
.DS_Store
Thumbs.db

# Sage 50 SDK assemblies - third-party binaries that must match the Sage 50
# version installed on each machine that builds/runs this service; populate
# locally, don't commit (see PortProSage.Core.csproj for details).
lib/Sage50SDK/
