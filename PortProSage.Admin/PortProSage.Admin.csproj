<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Deliberately modern .NET (matching whatever's actually installed - net10.0
      on this machine), not net48/x86 like the other three projects - this app
      never touches the Sage 50 SDK (only reads/writes the same JSON files and
      trigger-folder files the Service already uses), so it doesn't need to
      inherit the SDK's .NET Remoting / 32-bit / COM constraints. Keeping it on
      modern .NET gets a better WinForms designer/runtime and avoids any risk of
      destabilizing the working net48 pipeline in the other projects.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PortProSage.Admin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI access to another process's command line - used to tell an
         automatic (long-running, no run-once flag) Service instance apart
         from a manual one-off run (run-once), including ones started
         outside this app. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Same provider PortProSage.Core uses for state.db (Admin can't reference
         Core itself - different target frameworks), so the Watermark tab
         (MainForm.WatermarkTab.cs / WatermarkStateService) talks to the same
         SQLite file directly instead. Pinned to a newer major version than
         Core's 8.0.8 (net48-constrained) rather than matching it exactly -
         8.0.8's SQLitePCLRaw.lib.e_sqlite3 2.1.6 transitive dependency has a
         known high-severity advisory (GHSA-2m69-gcr7-jv3q); 10.0.x, which also
         matches Admin's net10.0-windows TFM, pulls a patched version instead. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
  </ItemGroup>

</Project>
