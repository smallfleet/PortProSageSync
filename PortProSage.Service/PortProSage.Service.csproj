<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Plain Microsoft.NET.Sdk, not Microsoft.NET.Sdk.Worker (that SDK targets modern
      .NET only) - Program.cs still builds the same Generic Host manually via
      Host.CreateApplicationBuilder, which works fine on net48 with these packages.
      Must match PortProSage.Core's TargetFramework (net48) - see that project for why.
    -->
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PortProSage.Service</RootNamespace>
    <!-- Must match PortProSage.Core's PlatformTarget (x86) - see that project for why. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk.Worker auto-referenced this on net8.0 (BackgroundService,
         ILogger<T>, Host.CreateApplicationBuilder) - plain Microsoft.NET.Sdk needs it explicit. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortProSage.Core\PortProSage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- appsettings.Local.json.example is checked in (the template for a new
         client deployment); appsettings.Local.json is this server's own real,
         git-ignored copy - "Update" doesn't error when a file is absent, so this
         is also safe on a machine that hasn't created appsettings.Local.json yet. -->
    <None Update="appsettings.Local.json.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
